---
// Override of Starlight's SocialIcons (registered in astro.config.mjs). The site has no social links; this slot
// of the header's right group — and of the mobile menu's footer, which renders the same component — carries the
// way back to the product pages instead: «← Сайт Tabula». Below 50rem the header's own right group is hidden and
// SiteTitle shows a short «← Сайт» next to the wordmark, so the way back is in the header at 320 px too.
// The href is built from `import.meta.env.BASE_URL` (the resolved `base`), like the footer's «На головну Tabula».
const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
---

<a class="guide-back" href={home}>
	<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
	Сайт Tabula
</a>

<style>
	@layer starlight.core {
		.guide-back {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			white-space: nowrap;
			text-decoration: none;
			font-weight: 600;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-2);
			padding: 0.5rem 0.25rem;
		}
		.guide-back:hover {
			color: var(--sl-color-text-accent);
		}
	}
</style>
