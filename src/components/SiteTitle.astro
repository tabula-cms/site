---
// Override of Starlight's default SiteTitle (registered in astro.config.mjs), design pass 3
// (issue #5, owner feedback: the header "looks bare/off" without a mark).
//
// Starlight's own SiteTitle is text-only; this adds a small inline SVG "tablet" mark (two
// offset rounded rectangles, stroke only, no fill) before the wordmark, decorative
// (aria-hidden="true") — the link's accessible name stays the title text, exactly as
// Starlight's own default provides via `siteTitleHref`/`siteTitle` (its own site title config
// value — "Tabula" today, from `astro.config.mjs`'s `starlight({ title: 'Tabula' })` — rather
// than a literal hardcoded here, so this stays a drop-in visual replacement of the text-only
// default even if that title ever changes). `siteTitleHref` is already base-aware (it comes
// from Starlight's own route data), so the link resolves correctly under either `SITE_BASE`
// without any extra handling here.
const { siteTitleHref, siteTitle } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<svg
		class="tabula-mark"
		aria-hidden="true"
		width="22"
		height="22"
		viewBox="0 0 22 22"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
	>
		<rect x="2" y="2" width="14" height="14" rx="3" stroke="currentColor" stroke-width="2" />
		<rect x="8" y="8" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="2" />
	</svg>
	<span class="tabula-wordmark" translate="no">{siteTitle}</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: 0.5rem;
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}

		.tabula-mark {
			flex-shrink: 0;
			color: var(--sl-color-accent);
		}

		.tabula-wordmark {
			font-size: 1.125rem;
			font-weight: 600;
			letter-spacing: 0.01em;
			color: var(--sl-color-white);
			overflow: hidden;
		}
	}
</style>
