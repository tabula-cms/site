---
// Override of Starlight's default SiteTitle (registered in astro.config.mjs): the product header's mark (the
// teal rounded square with the white «T», the same drawing as src/components/product/Header.astro and
// public/favicon.svg) and the wordmark in Unbounded, then the section's name «Посібник». The link's accessible
// name stays the title text, as in Starlight's default; `siteTitleHref` is already base-aware.
//
// Below 50rem the header's right group is hidden (Starlight), so a short «← Сайт» link sits next to the
// wordmark: the way back to the product pages stays in the header at 320 px. From 50rem the same link is the
// header's right group (src/components/SocialIcons.astro).
const { siteTitleHref, siteTitle } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<svg class="tabula-mark" aria-hidden="true" width="28" height="28" viewBox="0 0 34 34" xmlns="http://www.w3.org/2000/svg">
		<rect x="1" y="1" width="32" height="32" rx="9" fill="#1F6F66"></rect>
		<path d="M10 11h14M17 11v13" stroke="#FFFFFF" stroke-width="3.2" stroke-linecap="round" fill="none"></path>
	</svg>
	<span class="tabula-wordmark" translate="no">{siteTitle}</span>
</a>
<span class="guide-label">Посібник</span>
<a class="guide-back-short" href={home}>← Сайт</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: 0.55rem;
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}

		.tabula-mark {
			flex-shrink: 0;
		}

		.tabula-wordmark {
			font-family: 'Unbounded', 'Unbounded Fallback', sans-serif;
			font-size: 1.0625rem;
			font-weight: 600;
			color: var(--sl-color-white);
			overflow: hidden;
		}

		.guide-label {
			display: none;
			margin-inline-start: 0.75rem;
			padding-inline-start: 0.75rem;
			border-inline-start: 1px solid var(--sl-color-gray-5);
			font-size: var(--sl-text-sm);
			font-weight: 600;
			color: var(--sl-color-gray-3);
			white-space: nowrap;
		}

		.guide-back-short {
			margin-inline-start: 0.5rem;
			padding: 0.5rem 0.4rem;
			font-size: var(--sl-text-sm);
			font-weight: 600;
			white-space: nowrap;
			text-decoration: none;
			color: var(--sl-color-gray-2);
		}

		@media (min-width: 50rem) {
			.guide-label {
				display: inline;
			}
		}

		@media (min-width: 50rem) {
			.guide-back-short {
				display: none;
			}
		}
	}
</style>
