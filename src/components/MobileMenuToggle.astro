---
// Override of Starlight's MobileMenuToggle (registered in astro.config.mjs). Below 50rem the guide's sidebar opens from
// this button, which sits in the guide's bar under the product header (src/components/Header.astro; positioned by
// site.css): a pill with its name in words, «Розділи посібника», so it is never confused with the product header's
// «Меню». It opens Starlight's sidebar popover exactly as Starlight's own button does (no script of its own).
---

<button popovertarget="starlight__sidebar" class="sl-menu-button guide-menu-button print:hidden">
	<svg class="open-menu" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h10M4 17h16"></path></svg>
	<svg class="close-menu" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
	<span>Розділи посібника</span>
</button>

<style is:global>
	@layer starlight.core {
		body:has(#starlight__sidebar:popover-open) {
			overflow: hidden;
		}

		@media (min-width: 50rem) {
			body:has(#starlight__sidebar:popover-open) {
				overflow: auto;
			}
		}
	}
</style>
