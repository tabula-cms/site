---
// The sticky header of the product pages (story 80; the role pages joined it on 2026-11-14). From 1100 px: the
// dropdown «Для кого» (a native <details>: the three role pages and «Як це працює»), the six anchors and the button
// «Подати заявку» (and, once the demo is public, the secondary button «Спробувати» before it, from 1280 px); below
// 1100 px the button and a native <details> «Меню» that lists «Для кого» with its four links, the seven anchors and
// «Звʼязатися» (no JavaScript). On the home the anchors are `#…`; on other product pages they go to `{BASE_URL}#…`
// (prop `home`). The link to the page being shown carries aria-current="page".
import { offer, requestHref } from '../../config/offer.mjs';

const { home = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;
const prefix = home ? '' : root;
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const current = (href) => (href === here ? 'page' : undefined);
// «Для кого»: the four pages a visitor looks for first.
const forWhom = [
	['Директору', 'dlia-dyrektora'],
	['Тому, хто веде сайт', 'dlia-vidpovidalnoho'],
	['Бухгалтерії', 'dlia-bukhhalterii'],
	['Як це працює', 'yak-tse-pratsiuie'],
].map(([text, slug]) => ({ text, href: `${root}${slug}/` }));
const links = [
	['ШІ-помічник', 'assistant'],
	['Харчування', 'meals'],
	['Документи', 'docs'],
	['Шаблони', 'look'],
	['Ціна', 'price'],
	['Запитання', 'faq'],
].map(([text, id]) => ({ text, href: `${prefix}#${id}` }));
// «Контакти» is in the «Меню» panel only.
const panelLinks = [...links, { text: 'Контакти', href: `${prefix}#contact` }];
const chevron = 'M6 9l6 6 6-6';
---

<header class="site-header" data-site-header>
	<div class="site-header__inner">
		<a class="brand" href={root}>
			<svg width="30" height="30" viewBox="0 0 34 34" aria-hidden="true"
				><rect x="1" y="1" width="32" height="32" rx="9" fill="#1F6F66"></rect><path
					d="M10 11h14M17 11v13"
					stroke="#FFFFFF"
					stroke-width="3.2"
					stroke-linecap="round"></path></svg
			>
			<span class="brand__name">Tabula</span>
		</a>
		<nav class="nav-links" aria-label="Головне меню">
			<details class="nav-for">
				<summary>
					Для кого<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevron}></path></svg>
				</summary>
				<ul class="nav-for__panel">
					{forWhom.map((link) => <li><a href={link.href} aria-current={current(link.href)}>{link.text}</a></li>)}
				</ul>
			</details>
			{links.map((link) => <a href={link.href}>{link.text}</a>)}
		</nav>
		<div class="site-header__actions">
			{offer.demoOpen && <a class="btn btn-line btn-try" href={`${root}sprobuvaty/`} aria-current={current(`${root}sprobuvaty/`)}>Спробувати</a>}
			<a class="btn btn-main" href={requestHref(root, home)}>Подати заявку</a>
			<details class="nav-menu">
				<summary>
					<svg
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
					><span class="nav-menu__label">Меню</span>
				</summary>
				<nav class="nav-menu__panel" aria-label="Меню сторінки">
					<p class="nav-menu__heading" id="menu-for">Для кого</p>
					<ul aria-labelledby="menu-for">
						{forWhom.map((link) => <li><a href={link.href} aria-current={current(link.href)}>{link.text}</a></li>)}
					</ul>
					<ul class="nav-menu__main">
						{panelLinks.map((link) => <li><a href={link.href}>{link.text}</a></li>)}
						<li><a href={`mailto:${offer.supportEmail}`}>Звʼязатися</a></li>
					</ul>
				</nav>
			</details>
		</div>
	</div>
	<span class="page-progress" aria-hidden="true"></span>
</header>
