---
// The sticky header of the product pages (story 80). Seven links and the button «Подати заявку»
// above 900 px; below, the button and a native <details> «Меню» that lists the links and
// «Звʼязатися» (no JavaScript). On the home the links are `#…` anchors; on other product pages
// they go to `{BASE_URL}#…` (prop `home`).
import { offer } from '../../config/offer.mjs';

const { home = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;
const prefix = home ? '' : root;
const links = [
	['ШІ-помічник', 'assistant'],
	['Харчування', 'meals'],
	['Документи', 'docs'],
	['Шаблони', 'look'],
	['Ціна', 'price'],
	['Запитання', 'faq'],
	['Контакти', 'contact'],
].map(([text, id]) => ({ text, href: `${prefix}#${id}` }));
---

<header class="site-header" data-site-header>
	<div class="site-header__inner">
		<a class="brand" href={root}>
			<svg width="30" height="30" viewBox="0 0 34 34" aria-hidden="true"
				><rect x="1" y="1" width="32" height="32" rx="9" fill="#1F6F66"></rect><path
					d="M10 11h14M17 11v13"
					stroke="#FFFFFF"
					stroke-width="3.2"
					stroke-linecap="round"></path></svg
			>
			<span class="brand__name">Tabula</span>
		</a>
		<nav class="nav-links" aria-label="Головне меню">
			{links.map((link) => <a href={link.href}>{link.text}</a>)}
		</nav>
		<div class="site-header__actions">
			<a class="btn btn-main" href={`${prefix}#request`}>Подати заявку</a>
			<details class="nav-menu">
				<summary>
					<svg
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
					>Меню
				</summary>
				<nav class="nav-menu__panel" aria-label="Меню сторінки">
					<ul>
						{links.map((link) => <li><a href={link.href}>{link.text}</a></li>)}
						<li><a href={`mailto:${offer.supportEmail}`}>Звʼязатися</a></li>
					</ul>
				</nav>
			</details>
		</div>
	</div>
	<span class="page-progress" aria-hidden="true"></span>
</header>
