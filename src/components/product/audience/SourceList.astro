---
// Spec 83 §4: «Джерела» — the numbered list at the end of the page (laws and resolutions first, then explanations), each
// with a link back to its first mention and, when known, to the official text.
import { typo } from '../../../lib/typo.mjs';

interface Props {
	items: { title: string; url?: string | null }[];
}
const { items } = Astro.props;
---

<ol class="sources">
	{
		items.map((item, i) => (
			<li id={`source-${i + 1}`}>
				{item.url ? <a href={item.url}>{typo(item.title)}</a> : typo(item.title)}{' '}
				<a class="sources__back more" href={`#ref-${i + 1}`}>
					↑ до тексту
				</a>
			</li>
		))
	}
</ol>
