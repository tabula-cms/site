---
// Section 9: Панель. Six things the panel does, each with its own screen, and five short lines under them.
// The six steps are tabs (src/scripts/tabs.js, the same idea as the templates): choosing a step shows its screen on
// the laptop. Without JavaScript the tablist is hidden and the six panels are shown one under another, each with its
// heading and text.
import Shot from '../Shot.astro';
import { shots } from '../shots';

// The first two texts are the mockup's own strings; «кожна версія» became «попередні версії» because the news
// editor's «Історія» keeps the last 50 versions (docs/editor/novyny.md), not every one.
const steps = [
	{
		title: 'Що зробити сьогодні',
		text: 'Відкрили панель — і бачите наступні кроки. Нічого не треба тримати в голові.',
		src: shots.adminOverview,
		alt: 'Панель: екран «Огляд» з наступними кроками',
	},
	{
		title: 'Пишете, як у Word',
		text: 'Текст, фото й таблиці. Біля полів — підказки, а попередні версії зберігаються.',
		src: shots.adminNewsEditor,
		alt: 'Панель: редактор новини з кнопками «Фото» і «Таблиця» над текстом',
	},
	{
		title: 'Сторінки — як у меню сайту',
		text: 'Сторінки стоять так, як у меню. До кожної додаєте текст, документи, фото й людей.',
		src: shots.adminPages,
		alt: 'Панель: екран «Сторінки» зі списком сторінок сайту',
	},
	{
		title: 'Усі документи в одному місці',
		text: 'Статут, кошторис, накази — з типом і датою. Відвідувачі шукають їх за типом і роком.',
		src: shots.adminDocuments,
		alt: 'Панель: екран «Документи» з типами документів і списком файлів',
	},
	{
		title: 'Фотоальбоми подій',
		text: 'Перший дзвоник, олімпіади, екскурсії — альбомами, з підписами й автором фото.',
		src: shots.adminAlbums,
		alt: 'Панель: екран «Фотографії» зі списком альбомів',
	},
	{
		title: 'Календар подій',
		text: 'Збори, канікули, свята — з датою, часом і місцем. Батьки можуть підписатися на весь календар.',
		src: shots.adminEvents,
		alt: 'Панель: вкладка «Події» з найближчими подіями календаря',
	},
];
---

<section id="panel" class="anchor">
	<div class="wrap showcase showcase--wide tabs tabs--showcase" data-tabs>
		<h2 class="h2 reveal showcase__head">Панель, з якою впорається кожен</h2>
		<div role="tablist" aria-label="Панель" aria-orientation="vertical" class="showcase__tabs reveal" hidden>
			{
				steps.map((step, i) => (
					<button
						class="showcase__tab"
						type="button"
						role="tab"
						id={`tab-panel-${i + 1}`}
						aria-controls={`panel-panel-${i + 1}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
					>
						<span class="showcase__tab-title">{step.title}</span>
						<span class="showcase__tab-text">{step.text}</span>
					</button>
				))
			}
		</div>
		<div class="showcase__stage reveal">
			{
				steps.map((step, i) => (
					<div id={`panel-panel-${i + 1}`} class="tabpanel showcase__panel">
						<h3 class="tab-heading" data-tab-heading>{step.title}</h3>
						<p class="showcase__note">{step.text}</p>
						<div class="laptop">
							<div class="laptop__screen">
								<Shot src={step.src} alt={step.alt} widths={[560, 900, 1110]} sizes="(min-width: 1200px) 640px, (min-width: 900px) 50vw, calc(100vw - 40px)" />
							</div>
							<div class="laptop__base" aria-hidden="true" />
						</div>
					</div>
				))
			}
		</div>
	</div>
	<div class="wrap panel__foot">
		<ul class="panel__notes">
			<li><b>«Огляд» підкаже,</b> що зробити сьогодні.</li>
			<li><b>Ролі:</b> адміністратор, редактор, учні-автори з перевіркою.</li>
			<li><b>Нічого не пропадає:</b> журнал змін і кошик.</li>
			<li><b>Підказки</b> біля полів і довідка «Як зробити».</li>
			<li><b>Переїзд</b> зі старого сайту на WordPress.</li>
		</ul>
	</div>
</section>
