---
// Section 4: Харчування. Four steps as tabs (src/scripts/tabs.js, the same idea as the templates): choosing a step
// shows its picture — the panel's «Харчування», the public day page with the parents' chat card (a neutral card,
// no Viber or Telegram branding beyond the words), the day page with allergens, and the menu sheet the assistant
// reads. Without JavaScript the tablist is hidden and the four panels are shown one under another, each with its
// heading and text. The allergens claim links to «Закон і сайт школи» in its own <li> (spec decision 14).
import Shot from '../Shot.astro';
import { shots } from '../shots';

const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;

const steps = [
	{ id: 'photo', title: 'Чотири дотики', text: 'Сфотографували порцію в їдальні — день уже на сайті.' },
	{ id: 'share', title: '«Поділитися» у Viber і Telegram', text: 'У кожного дня своя адреса, у чаті батьків видно фото й страви.' },
	{ id: 'allergens', title: 'Алергени й калорійність', text: 'Біля кожної страви, а під меню — розшифровка кодів.' },
	{ id: 'assistant', title: 'ШІ-помічник', text: 'Читає меню з фото аркуша й перевіряє, чи не потрапили в кадр діти.' },
];
---

<section id="meals" class="anchor band">
	<div class="wrap showcase tabs tabs--showcase" data-tabs>
		<h2 class="h2 reveal showcase__head">Харчування — за хвилину з&#160;телефона</h2>
		<div role="tablist" aria-label="Харчування" aria-orientation="vertical" class="showcase__tabs reveal" hidden>
			{
				steps.map((step, i) => (
					<button
						class="showcase__tab"
						type="button"
						role="tab"
						id={`tab-meals-${step.id}`}
						aria-controls={`panel-meals-${step.id}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
					>
						<span class="showcase__tab-title">{step.title}</span>
						<span class="showcase__tab-text">{step.text}</span>
					</button>
				))
			}
		</div>
		<div class="showcase__stage reveal">
			<div id="panel-meals-photo" class="tabpanel showcase__panel">
				<h3 class="tab-heading" data-tab-heading>{steps[0].title}</h3>
				<p class="showcase__note">{steps[0].text}</p>
				<div class="showcase__visual">
					<div class="phone-frame phone-frame--tall">
						<Shot src={shots.adminMeals} alt="Панель на телефоні: екран «Харчування» з кнопкою «Сфотографувати порцію»" widths={[240, 480, 580]} sizes="240px" />
					</div>
				</div>
			</div>
			<div id="panel-meals-share" class="tabpanel showcase__panel">
				<h3 class="tab-heading" data-tab-heading>{steps[1].title}</h3>
				<p class="showcase__note">{steps[1].text}</p>
				<div class="showcase__visual showcase__visual--share">
					<div class="phone-frame">
						<Shot src={shots.phoneMealDay} alt="Сторінка дня на сайті з кнопками «Поділитися», Telegram і Viber" widths={[240, 480, 600]} sizes="240px" />
					</div>
					<div class="chat">
						<p class="chat__name">Чат «Батьки 5-А»</p>
						<div class="chat__bubble">
							<div class="chat__row">
								<Shot src={shots.food2} alt="" widths={[54, 108]} sizes="54px" />
								<div>
									<p>Харчування — пʼятниця, 6&#160;листопада</p>
									<p>Каша вівсяна, борщ, котлета з пюре…</p>
									<p>licey0.tabula.org.ua</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div id="panel-meals-allergens" class="tabpanel showcase__panel">
				<h3 class="tab-heading" data-tab-heading>{steps[2].title}</h3>
				<p class="showcase__note">{steps[2].text}</p>
				<div class="showcase__visual">
					<div class="phone-frame">
						<Shot src={shots.phoneMealAllergens} alt="Сторінка дня на сайті: біля кожної страви рядок «алергени: …» і калорійність, під меню — розшифровка кодів" widths={[240, 480, 600]} sizes="240px" />
					</div>
				</div>
				<ul class="showcase__caption">
					<li>15 алергенів за <a href={`${root}zakon-i-sait-shkoly/`}>постановою №&#160;305</a>.</li>
				</ul>
			</div>
			<div id="panel-meals-assistant" class="tabpanel showcase__panel">
				<h3 class="tab-heading" data-tab-heading>{steps[3].title}</h3>
				<p class="showcase__note">{steps[3].text}</p>
				<div class="showcase__visual">
					<div class="meals__sheet">
						<div class="meals__sheet-paper">
							<p class="meals__sheet-hand">Вівторок<br />Сніданок — каша вівсяна з ягодами, чай<br />Обід — борщ, котлета з пюре, компот</p>
							<div class="meals__sheet-scan" aria-hidden="true"></div>
						</div>
						<div class="meals__sheet-out">
							<p><b>Сніданок</b> Каша вівсяна з ягодами · Чай</p>
							<p><b>Обід</b> Борщ · Котлета з пюре</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
