---
// Section 1: the hero. The laptop is the page's LCP image: eager, fetchpriority high, and
// preloaded in the <head> by src/pages/index.astro with the same widths/sizes.
import Shot from '../Shot.astro';
import { shots, HERO } from '../shots';
import { offer, formatDateLongYear, demoHref, exampleIsSeparate, requestHref } from '../../../config/offer.mjs';

const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;
// The demo site when it exists, else its «У розробці» page.
const exampleHref = demoHref(root);
// Once the demo is public (offer.demoOpen) «Спробувати демо» is the primary button, «Подати заявку» the secondary one and
// the example site a quiet link under them, shown only when it is a site of its own (exampleIsSeparate: a read-only
// demo site); until the demo is public it is linked from nowhere.
const tryOpen = offer.demoOpen;
const example = exampleIsSeparate();
// Until the assistant is on for schools the hero names what already works, not what is being tested.
const assistantOn = offer.assistantStatus === 'on';
---

<section id="top" class="hero">
	<div class="wrap hero__inner">
		<div class="hero__text">
			<div class="hero__top">
				<p class="chip">Безкоштовно до {formatDateLongYear(offer.pilotUntil)}</p>
				<a class="hero__terms" href="#price">Умови й ціна <span aria-hidden="true">→</span></a>
			</div>
			<h1 class="hero__title">Сайт <span class="nw">закладу освіти</span> <span class="nw">без рутини</span></h1>
			<p class="hero__sub">
				{
					assistantOn
						? 'ШІ-помічник готує новини, меню й документи. Ви лише перевіряєте й публікуєте.'
						: 'Готові розділи за законом, меню дня з телефона й документи з КЕП. Ви лише додаєте зміст.'
				}
			</p>
			<p class="hero__kinds">Для шкіл, садочків, коледжів і закладів професійної освіти.</p>
			{
				tryOpen ? (
					<>
						<div class="hero__buttons">
							<a class="btn btn-main btn-lg" href={`${root}sprobuvaty/`}>Спробувати демо</a>
							<a class="btn btn-line btn-lg" href={requestHref(root, true)}>Подати заявку</a>
						</div>
						{example && (
							<p class="hero__kinds hero__example">
								<a href={exampleHref}>Подивитися приклад сайту</a>
							</p>
						)}
					</>
				) : (
					<div class="hero__buttons">
						<a class="btn btn-main btn-lg" href={requestHref(root, true)}>Подати заявку</a>
						<a class="btn btn-line btn-lg" href={exampleHref}>Подивитися приклад сайту</a>
					</div>
				)
			}
		</div>
		<div class="hero__visual">
			<div class="laptop">
				<div class="laptop__screen">
					<Shot
						src={shots.tplPanorama}
						alt="Демонстраційний сайт ліцею в шаблоні «Панорама» на ноутбуці"
						widths={[...HERO.widths]}
						sizes={HERO.sizes}
						quality={HERO.quality}
						priority
					/>
				</div>
				<div class="laptop__base" aria-hidden="true"></div>
			</div>
			<div class="phone-frame hero__phone">
				<Shot
					src={shots.phoneMealDay}
					alt="Сторінка дня харчування на телефоні з кнопками «Поділитися», Telegram і Viber"
					widths={[160, 240, 320]}
					sizes="(min-width: 1030px) 130px, 25vw"
					eager
				/>
			</div>
		</div>
	</div>
</section>
