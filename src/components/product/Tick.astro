---
// The green check mark of the bullet lists (decorative).
const { size = 22, width = 2.6 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="#1F6F66"
	stroke-width={width}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg
>
