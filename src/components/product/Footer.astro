---
// The footer of the product pages (footer-and-audience-pages spec, 2026-11-09): the brand column, then three
// columns — «Для кого», «Корисно знати», «Допомога» — and a bottom row with the legal links (personal data,
// accessibility, the privacy address), the footer line (`footerLine`, verbatim; check-built holds it on every
// page) and «© 2026 Tabula». The «Продукт» column is gone: its anchors are in the header, «Демо-сайт» and
// «Подати заявку» are on the home's first screen. Links are base-aware (`BASE_URL`); the link to the page
// being shown carries aria-current="page". On phones the columns go two by two (section 14 of product.css).
// The «Довідка» link renders only when `help` is on (the docs story turns it on).
import { offer, footerLine } from '../../config/offer.mjs';

const { help = false, home = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;
const page = (slug: string) => `${root}${slug}/`;
// The home's anchors: `#…` on the home, `{BASE_URL}#…` on every other product page.
const anchor = (id: string) => `${home ? '' : root}#${id}`;
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const current = (href: string) => (href === here ? 'page' : undefined);

const columns = [
	{
		title: 'Для кого',
		links: [
			['Для директора', page('dlia-dyrektora')],
			['Для відповідального за сайт', page('dlia-vidpovidalnoho')],
			['Для бухгалтерії', page('dlia-bukhhalterii')],
		],
	},
	{
		title: 'Корисно знати',
		links: [
			['Як це працює', page('yak-tse-pratsiuie')],
			['Ціна й оплата', page('khostynh-i-tsina')],
			['Закон і сайт школи', page('zakon-i-sait-shkoly')],
			['Безпека й дані', page('bezpeka-i-dani')],
		],
	},
	{
		title: 'Допомога',
		links: [
			['Часті запитання', anchor('faq')],
			['Підтримка', page('pidtrymka')],
			[offer.supportEmail, `mailto:${offer.supportEmail}`],
			...(help ? [['Довідка', `${root}dokumentatsiia/`]] : []),
		],
	},
];
---

<footer class="site-footer" id="footer-nav">
	<div class="site-footer__inner">
		<div class="site-footer__lead">
			<a class="site-footer__brand" href={root} aria-current={current(root)}>
				<svg width="26" height="26" viewBox="0 0 34 34" aria-hidden="true"
					><rect x="1" y="1" width="32" height="32" rx="9" fill="#1F6F66"></rect><path
						d="M10 11h14M17 11v13"
						stroke="#FFFFFF"
						stroke-width="3.2"
						stroke-linecap="round"></path></svg
				>
				<span>Tabula</span>
			</a>
			<p class="site-footer__about">Сайти для шкіл, садочків і коледжів — з готовими розділами за законом.</p>
			<p class="site-footer__more">
				<a href={page('pro-proiekt')} aria-current={current(page('pro-proiekt'))}>Про проєкт</a>
			</p>
		</div>
		{
			columns.map((column) => (
				<nav class="site-footer__col" aria-label={column.title}>
					<p class="site-footer__title">{column.title}</p>
					<ul>
						{column.links.map(([text, href]) => (
							<li>
								<a href={href} aria-current={current(href)}>
									{text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
		<div class="site-footer__bottom">
			<p class="site-footer__legal-links">
				<a href={page('personalni-dani')} aria-current={current(page('personalni-dani'))}>Обробка персональних даних</a>
				<span aria-hidden="true">·</span>
				<a href={page('dostupnist')} aria-current={current(page('dostupnist'))}>Доступність</a>
				<span aria-hidden="true">·</span>
				<a href={`mailto:${offer.operatorEmail}`}>{offer.operatorEmail}</a>
			</p>
			<p class="site-footer__legal">{footerLine}</p>
			<p class="site-footer__copy">© 2026 Tabula</p>
		</div>
	</div>
</footer>
