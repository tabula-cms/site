---
// «Від пілоту до оплати: платіж завжди після акта» (footer-and-audience-pages spec, «Для бухгалтерії»): who
// sends what to whom, in three bands of time, for three participants. Text, not a picture: an ordered list of
// the bands; each step is a description list (participant -> what they do). From 760 px the participants
// line up as columns under a header row (the header is aria-hidden, every cell keeps its own visually hidden
// <dt>); below, every step is a card with the participant named in each line. Numbers come from offer.mjs.
import { offer, formatDate, formatGrn, nextDay } from '../../config/offer.mjs';

const year = nextDay(offer.pilotUntil).slice(0, 4);
const who = ['Tabula', 'Заклад', 'Казначейство, Prozorro'];
const none = null;
const bands = [
	{
		title: `Пілот, до ${formatDate(offer.pilotUntil)}`,
		steps: [
			['Угода про пілот — надсилаємо у «Вчасно»', 'Підписує угоду (КЕП директора)', none],
			[
				`Акт за пілот — ${formatGrn(offer.pilotValueUah)} за кожен місяць`,
				'Ставить на облік як благодійну допомогу; на сайті за 10 робочих днів',
				none,
			],
		],
	},
	{
		title: `Підготовка до ${year} року, вересень–січень`,
		steps: [
			[none, 'Рядок у річному плані (ДК 021, КЕКВ 2240)', 'План у Prozorro за 5 робочих днів'],
			[
				`Договір на ${year} рік — надсилаємо у «Вчасно»`,
				'Підписує договір (КЕП директора)',
				'Реєстрація зобовʼязання: січень, до 7 робочих днів',
			],
		],
	},
	{
		title: `Щокварталу з ${year} року`,
		steps: [['Акт і рахунок — у «Вчасно», щокварталу', 'Підписує акт (КЕП директора)', `Оплата ${formatGrn(offer.priceQuarterUah)} через казначейство`]],
		pay: true,
	},
];
---

<figure class="flow" aria-labelledby="flow-title">
	<figcaption id="flow-title" class="flow__title">Від пілоту до оплати: платіж завжди після акта</figcaption>
	<div class="flow__head" aria-hidden="true">
		<span></span>
		{who.map((name) => <span>{name}</span>)}
	</div>
	<ol class="flow__bands">
		{
			bands.map((band) => (
				<li class="flow__band">
					<h3 class="flow__band-title">{band.title}</h3>
					<ol class="flow__steps">
						{band.steps.map((step) => (
							<li>
								<dl class="flow__step">
									{step.map((text, i) => (
										<div class:list={['flow__cell', { 'flow__cell--none': text === null, 'flow__cell--pay': band.pay && i === 2 }]}>
											<dt>{who[i]}</dt>
											<dd>
												{text === null ? (
													<>
														<span aria-hidden="true">—</span>
														<span class="sr">нічого на цьому кроці</span>
													</>
												) : band.pay && i === 2 ? (
													<strong>{text}</strong>
												) : (
													text
												)}
											</dd>
										</div>
									))}
								</dl>
							</li>
						))}
					</ol>
				</li>
			))
		}
	</ol>
	<p class="flow__note">Усі документи — з КЕП у «Вчасно», від угоди про пілот до щоквартального акта.</p>
</figure>
