---
// Override of Starlight's default Footer (registered in astro.config.mjs). Since slice S2 of story 80
// every Starlight page is a documentation page (`template: doc`), so Starlight's own footer content —
// edit link, pagination — is kept above ours.
//
// Ours: one link back to the product home («На головну Tabula»), the project's own GitHub links, the
// tagline and the operator line of story 78's decision 5 (`operatorLine` from `offer.mjs`, checked on
// every page by `check-built.mjs`). The documentation is not linked from the product pages, so this is
// the only way back. The home link is built from `import.meta.env.BASE_URL` (Astro's resolved `base`):
// this footer renders at every page depth, so a single relative path cannot be correct everywhere;
// `scripts/check-links.mjs` resolves an absolute (leading-slash) href against its own base-prefixed page
// map.
import Default from '@astrojs/starlight/components/Footer.astro';
import { operatorLine } from '../config/offer.mjs';

const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;

const links = [
	{ text: 'На головну Tabula', href: home },
	{ text: 'Репозиторій на GitHub', href: 'https://github.com/tabula-cms/tabula' },
	{ text: 'Ліцензія AGPL-3.0', href: 'https://github.com/tabula-cms/tabula/blob/main/LICENSE' },
	{ text: 'Повідомити про помилку', href: 'https://github.com/tabula-cms/tabula/issues/new/choose' },
	{ text: 'Повідомити про вразливість', href: 'https://github.com/tabula-cms/tabula/security/policy' },
];
---

<Default />

<footer class="site-footer not-content">
	<nav class="site-footer-links" aria-label="Про сайт">
		{
			links.map(({ text, href }, index) => (
				<>
					{index > 0 && <span class="site-footer-sep" aria-hidden="true">·</span>}
					<a href={href}>{text}</a>
				</>
			))
		}
	</nav>
	<p class="site-footer-tagline">
		Система вільна й безкоштовна назавжди. Розміщення сайту проєктом — платна послуга, з якої
		фінансується розвиток системи.
	</p>
	<p class="site-footer-operator">{operatorLine}</p>
</footer>

<style>
	@layer starlight.components {
		.site-footer {
			margin-top: 2rem;
			padding-top: 1.5rem;
			border-top: 1px solid var(--sl-color-hairline);
			font-size: var(--sl-text-xs);
			color: var(--sl-color-gray-3);
		}

		.site-footer-links {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.5rem;
		}

		.site-footer-links a {
			color: var(--sl-color-gray-2);
			text-decoration: none;
		}

		.site-footer-links a:hover {
			color: var(--sl-color-accent);
			text-decoration: underline;
		}

		.site-footer-sep {
			color: var(--sl-color-gray-5);
		}

		.site-footer-operator,
		.site-footer-tagline {
			margin-top: 0.5rem;
		}
	}
</style>
