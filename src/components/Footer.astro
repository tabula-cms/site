---
// Override of Starlight's default Footer (registered in astro.config.mjs). Starlight's own footer content stays first (the
// «Назад / Далі» cards; the edit link renders nothing, src/components/EditLink.astro), then the product's footer itself,
// src/components/product/Footer.astro (owner, 2026-11-15: the guide carries the product's header and footer): the brand,
// «Для кого», «Про сервіс», «Допомога» (with «Посібник редактора»), the legal links, `footerLine` (check-built holds it on
// every page) and «© 2026 Tabula». Its styles are the product's (src/styles/chrome.css); in the guide's column it takes
// the product's own narrow arrangement (site.css).
import Default from '@astrojs/starlight/components/Footer.astro';
import ProductFooter from './product/Footer.astro';
---

<Default />
<ProductFooter />
