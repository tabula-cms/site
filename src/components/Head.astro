---
// Override of Starlight's Head (registered in astro.config.mjs): Starlight's own tags, plus a preload of the two
// Fixel files (Display for the page title and the wordmark, Text for the rest), the same set as src/layouts/Product.astro. The shared @font-face rules
// (src/styles/fonts.css) are `font-display: optional`, which only works when the files are preloaded: used from
// the first paint or not at all, so the text never jumps when a font arrives.
import Default from '@astrojs/starlight/components/Head.astro';
import fixelDisplay from '../assets/fonts/fixel/FixelDisplay-Variable.woff2?url';
import fixelText from '../assets/fonts/fixel/FixelText-Variable.woff2?url';
const preloadFonts = [fixelDisplay, fixelText];
---

<Default {...Astro.props}><slot /></Default>
{preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
