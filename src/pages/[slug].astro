---
// The site's own reading pages (story 80, slice S2): one route per file of src/content/pages/, at
// /<slug>/ under the base — the addresses the pages had when they were Starlight's. A page with `hero` in its
// frontmatter (spec 83: the three role pages and «Ціна й оплата») uses RolePage.astro; the rest the narrow
// ProductPage.astro. Every body goes through Typo.astro (the no-break spaces of spec 83's rules).
import { getCollection, render } from 'astro:content';
import ProductPage from '../layouts/ProductPage.astro';
import RolePage from '../layouts/RolePage.astro';
import Typo from '../components/product/Typo.astro';

export async function getStaticPaths() {
	const pages = await getCollection('pages');
	return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
// Spec 83 §9: the band above the footer is on every page but the request form.
const cta = entry.id !== 'zaiavka';
---

{
	entry.data.hero ? (
		<RolePage title={entry.data.title} description={entry.data.description} hero={entry.data.hero} headings={headings}>
			<Typo headings={headings}>
				<Content />
			</Typo>
		</RolePage>
	) : (
		<ProductPage title={entry.data.title} description={entry.data.description} cta={cta}>
			<Typo>
				<Content />
			</Typo>
		</ProductPage>
	)
}
