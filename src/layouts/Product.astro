---
// The layout of the site's own product pages (story 80, decision 1): its own design, no Starlight.
// `<html data-product-page>` is what scripts/check-built.mjs keys its product-page rules on.
//
// Props: `title`, `description`; `home` (the page is the home, so the header's links are `#…`
// anchors; on every other product page they go to `{BASE_URL}#…`); `help` (turns on the
// footer's «Довідка» slot — off until the documentation story); `cta` (the band above the footer, spec 83 §9).
import '../styles/product.css';
import Header from '../components/product/Header.astro';
import Footer from '../components/product/Footer.astro';
import PreFooterCta from '../components/product/PreFooterCta.astro';
// The five font files the first screen needs most (the heading, the wordmark, the text, the nav links, the buttons): preloaded, and
// `font-display: optional` in product.css §1, so they are either there for the first paint or never swap in (no
// layout shift from a late font).
import unboundedCyrillic600 from '@fontsource/unbounded/files/unbounded-cyrillic-600-normal.woff2?url';
import unboundedLatin600 from '@fontsource/unbounded/files/unbounded-latin-600-normal.woff2?url';
import manropeCyrillic400 from '@fontsource/manrope/files/manrope-cyrillic-400-normal.woff2?url';
import manropeCyrillic600 from '@fontsource/manrope/files/manrope-cyrillic-600-normal.woff2?url';
import manropeCyrillic700 from '@fontsource/manrope/files/manrope-cyrillic-700-normal.woff2?url';
const preloadFonts = [unboundedCyrillic600, unboundedLatin600, manropeCyrillic400, manropeCyrillic600, manropeCyrillic700];

interface Props {
	title: string;
	description?: string;
	home?: boolean;
	help?: boolean;
	// Spec 83 §9: the band above the footer; off on the request form only.
	cta?: boolean;
}
const { title, description, home = false, help = false, cta = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;
---

<!doctype html>
<html lang="uk" data-product-page>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="icon" type="image/svg+xml" href={`${root}favicon.svg`} />
		{preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">Перейти до вмісту</a>
		<div class="page">
			<Header home={home} />
			<main id="main">
				<slot />
			</main>
			{cta && <PreFooterCta home={home} />}
			<Footer help={help} home={home} />
		</div>
		<script>
			import '../scripts/header.js';
		</script>
	</body>
</html>
